---
import Layout from "../layouts/Layout.astro";
import PixelDot from "./PixelDot.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { getDictionary, type Locale } from "../i18n";
import { DOCS_URL, GITHUB_URL } from "../lib/site";
import icon from "../assets/icon.svg?url";
import awsLogo from "../assets/logos/amazonwebservices.svg?raw";
import azureLogo from "../assets/logos/azure.svg?raw";
import googleCloudLogo from "../assets/logos/googlecloud.svg?raw";
import kubernetesLogo from "../assets/logos/kubernetes.svg?raw";
import "../styles/landing.css";

/** Monochrome brand marks for the deploy-anywhere visual. */
const deployTargets = [
  { name: "AWS", svg: awsLogo },
  { name: "Google Cloud", svg: googleCloudLogo },
  { name: "Azure", svg: azureLogo },
  { name: "Kubernetes", svg: kubernetesLogo },
];

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

// FAQPage only; other entity JSON-LD is emitted by Layout on home pages.
const faqJsonLd = {
  "@type": "FAQPage",
  mainEntity: t.faq.items.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

/**
 * Architecture diagram, turbopuffer style. Every line is exactly 73
 * characters, so the block stays rectangular in any monospace font.
 */
/** Plain-text sources for the copy-code buttons, one per SDK panel. */
const tsExample = `import { FissionPlane } from '@fissionplane/sdk'

const client = new FissionPlane()
const sandbox = await client.sandboxes.create({ template: 'base' })

const result = await sandbox.commands.run('echo', {
  args: ['hello from a microVM'],
})

console.log(result.stdout)
await sandbox.delete()`;

const pyExample = `from fissionplane import FissionPlane

client = FissionPlane()
sandbox = client.sandboxes.create("base")

result = sandbox.commands.run(
    "echo",
    args=["hello from a microVM"],
)

print(result.stdout)
sandbox.delete()`;

const rustExample = `use fissionplane::models::{CreateSandboxRequest, RunCommandRequest};
use fissionplane::{ClientOptions, FissionPlane};

#[tokio::main]
async fn main() -> Result<(), fissionplane::Error> {
    let client = FissionPlane::new(ClientOptions::new())?;

    let request = CreateSandboxRequest {
        template: "base".to_owned(),
        ..Default::default()
    };
    let sandbox = client.sandboxes().create(request, None).await?;

    let run = RunCommandRequest {
        command: "echo".to_owned(),
        args: Some(vec!["hello from a microVM".to_owned()]),
        ..Default::default()
    };
    let result = sandbox.commands()?.run(run).await?;

    println!("{}", result.stdout);
    sandbox.delete().await?;
    Ok(())
}`;

const RAW_CONTRACTS_URL =
  "https://raw.githubusercontent.com/ManuelAngel99/fissionplane/main/src/contracts";

/**
 * Copied to the clipboard by the "let your AI agent build your own SDK"
 * link. Written in ASD-STE100 style: short sentences, active voice, one
 * instruction per sentence, consistent terms. Always English — it speaks
 * to an AI agent, not to the visitor.
 */
const agentPrompt = `Build a FissionPlane SDK for my target language.

Context: FissionPlane is an open-source compute platform. It runs sandboxes and serverless functions in Firecracker microVMs. Two OpenAPI 3.0 contracts define its HTTP APIs. The contracts are the source of truth. Reference SDKs exist for TypeScript, Python, and Rust.

Sources:
- Documentation: ${DOCS_URL}
- Control-plane contract (sandbox and template lifecycle): ${RAW_CONTRACTS_URL}/openapi.yaml
- Data-plane contract (commands, files, PTYs, ports): ${RAW_CONTRACTS_URL}/dataplane.yaml
- Streaming protocol: ${GITHUB_URL}/blob/main/src/contracts/dataplane-streaming.md
- Reference SDKs: ${GITHUB_URL}/tree/main/src/sdks

Instructions:
1. Ask me for the target language. Do not start before I answer.
2. Read the documentation. Learn how a client authenticates and how it finds the base URL.
3. Download both contracts. Generate all request and response types from them. Do not write the types by hand.
4. Implement every operation in the control-plane contract.
5. Implement every operation in the data-plane contract.
6. Implement the streaming surface as the streaming document describes it.
7. Use the shared error schema for all failures. Expose the "code" and "retryable" fields to the caller.
8. Match the public API shape of the reference SDKs. Use the idioms of the target language.
9. Write a test for each operation.
10. Show me the package layout before you write the code.`;

const architectureDiagram = `                 ╔═ your kubernetes cluster ═══════════════════════════╗ 
╔══════════════╗ ║   ┌───────────────┐          ┌──────────────────┐   ║░
║  SDK / REST  ║─╫──▶│    gateway    │──mTLS───▶│  node · vm-host  │   ║░
╚══════════════╝ ║   │ TLS · routing │          │  ┌────────────┐  │   ║░
 ░░░░░░░░░░░░░░  ║   └───────────────┘          │  │ ▪ microVM  │  │   ║░
                 ║   ┌───────────────┐          │  │ ▪ microVM  │  │   ║░
                 ║   │ control plane │──gRPC───▶│  │ ▪ microVM  │  │   ║░
                 ║   │ place · quota │          │  └────────────┘  │   ║░
                 ║   └───────────────┘          └────────┬─────────┘   ║░
                 ║                                 pause │ resume      ║░
                 ║                              ┌────────▼─────────┐   ║░
                 ║                              │  object storage  │   ║░
                 ║                              └──────────────────┘   ║░
                 ╚═════════════════════════════════════════════════════╝░
                  ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░`;
---

<Layout
