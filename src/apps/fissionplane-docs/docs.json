{
  "$schema": "https://mintlify.com/docs.json",
  "name": "FissionPlane",
  "theme": "aspen",
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#4B4646",
    "light": "#B7B1B1",
    "dark": "#847E7E"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://fissionplane.dev"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "IBM Plex Mono",
    "heading": {
      "family": "IBM Plex Mono",
      "weight": 700
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FCFAFA",
      "dark": "#131110"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark-default"
      }
    }
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/ManuelAngel99/fissionplane"
    },
    "links": [
      {
        "label": "fissionplane.dev",
        "href": "https://fissionplane.dev"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "installation"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/sandboxes",
              "concepts/templates",
              "concepts/functions",
              "concepts/architecture",
              "concepts/security"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/run-commands",
              "guides/filesystem",
              "guides/ports",
              "guides/pause-resume",
              "guides/build-templates"
            ]
          },
          {
            "group": "SDKs",
            "pages": [
              "sdks/typescript",
              "sdks/python",
              "sdks/rust"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api/overview",
              "api/authentication"
            ]
          },
          {
            "group": "Control Plane",
            "pages": [
              "api/sandboxes",
              "api/templates",
              "api/tokens"
            ]
          },
          {
            "group": "Data Plane",
            "pages": [
              "api/commands",
              "api/files",
              "api/streaming"
            ]
          }
        ]
      }
    ]
  }
}
