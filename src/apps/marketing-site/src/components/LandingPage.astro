                    <svg data-slot="check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </span>
                </button>
                <pre data-slot="example"><code><span class="t-k">import</span> <span class="t-x">&#123;</span> <span class="t-d">FissionPlane</span> <span class="t-x">&#125;</span> <span class="t-k">from</span> <span class="t-s">'@fissionplane/sdk'</span>

<span class="t-k">const</span> client <span class="t-x">=</span> <span class="t-k">new</span> <span class="t-d">FissionPlane</span><span class="t-x">()</span>
<span class="t-k">const</span> sandbox <span class="t-x">=</span> <span class="t-k">await</span> client<span class="t-x">.</span><span class="t-p">sandboxes</span><span class="t-x">.</span><span class="t-p">create</span><span class="t-x">(&#123;</span> <span class="t-p">template</span><span class="t-x">:</span> <span class="t-s">'base'</span> <span class="t-x">&#125;)</span>

<span class="t-k">const</span> result <span class="t-x">=</span> <span class="t-k">await</span> sandbox<span class="t-x">.</span><span class="t-p">commands</span><span class="t-x">.</span><span class="t-p">run</span><span class="t-x">(</span><span class="t-s">'echo'</span><span class="t-x">,</span> <span class="t-x">&#123;</span>
  <span class="t-p">args</span><span class="t-x">:</span> <span class="t-x">[</span><span class="t-s">'hello from a microVM'</span><span class="t-x">],</span>
<span class="t-x">&#125;)</span>

console<span class="t-x">.</span><span class="t-p">log</span><span class="t-x">(</span>result<span class="t-x">.</span><span class="t-p">stdout</span><span class="t-x">)</span>
<span class="t-k">await</span> sandbox<span class="t-x">.</span><span class="t-p">delete</span><span class="t-x">()</span></code></pre>
                <button type="button" data-slot="copy-code" data-copy={tsExample} data-copy-label={t.install.copyCode} data-copied-label={t.install.copiedLabel} aria-label={t.install.copyCode}>
