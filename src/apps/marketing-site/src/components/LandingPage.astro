                    <svg data-slot="check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </span>
                </button>
                <pre data-slot="example"><code><span class="t-k">use</span> fissionplane<span class="t-x">::</span>models<span class="t-x">::&#123;</span><span class="t-d">CreateSandboxRequest</span><span class="t-x">,</span> <span class="t-d">RunCommandRequest</span><span class="t-x">&#125;;</span>
<span class="t-k">use</span> fissionplane<span class="t-x">::&#123;</span><span class="t-d">ClientOptions</span><span class="t-x">,</span> <span class="t-d">FissionPlane</span><span class="t-x">&#125;;</span>

<span class="t-c">#[tokio::main]</span>
<span class="t-k">async fn</span> <span class="t-d">main</span><span class="t-x">() -&gt;</span> <span class="t-d">Result</span><span class="t-x">&lt;(),</span> fissionplane<span class="t-x">::</span><span class="t-d">Error</span><span class="t-x">&gt; &#123;</span>
    <span class="t-k">let</span> client <span class="t-x">=</span> <span class="t-d">FissionPlane</span><span class="t-x">::</span><span class="t-p">new</span><span class="t-x">(</span><span class="t-d">ClientOptions</span><span class="t-x">::</span><span class="t-p">new</span><span class="t-x">())?;</span>

    <span class="t-k">let</span> request <span class="t-x">=</span> <span class="t-d">CreateSandboxRequest</span> <span class="t-x">&#123;</span>
        <span class="t-p">template</span><span class="t-x">:</span> <span class="t-s">"base"</span><span class="t-x">.</span><span class="t-p">to_owned</span><span class="t-x">(),</span>
        <span class="t-x">..</span><span class="t-d">Default</span><span class="t-x">::</span><span class="t-p">default</span><span class="t-x">()</span>
    <span class="t-x">&#125;;</span>
    <span class="t-k">let</span> sandbox <span class="t-x">=</span> client<span class="t-x">.</span><span class="t-p">sandboxes</span><span class="t-x">().</span><span class="t-p">create</span><span class="t-x">(</span>request<span class="t-x">,</span> <span class="t-n">None</span><span class="t-x">).</span><span class="t-k">await</span><span class="t-x">?;</span>

    <span class="t-k">let</span> run <span class="t-x">=</span> <span class="t-d">RunCommandRequest</span> <span class="t-x">&#123;</span>
