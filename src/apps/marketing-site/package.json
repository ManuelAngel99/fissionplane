{
  "name": "@fissionplane/marketing-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "cf:deploy": "wrangler deploy",
    "cf:dry-run": "wrangler deploy --dry-run",
    "format:check": "oxfmt --check package.json wrangler.jsonc tsconfig.json worker/tsconfig.json",
    "lint": "oxlint --type-aware .",
    "worker:typecheck": "tsc --project worker/tsconfig.json",
    "astro": "astro",
    "og:image": "node scripts/generate-og-image.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/ibm-plex-mono": "^5",
    "astro": "^7.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.9.0",
    "wrangler": "^4"
  }
}
