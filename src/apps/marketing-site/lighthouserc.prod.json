{
  "ci": {
    "collect": {
      "url": ["https://fissionplane.dev", "https://fissionplane.dev/es"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.9, "aggregationMethod": "median" }
        ],
        "categories:accessibility": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median" }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median" }
        ],
        "categories:seo": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median" }
        ],
        "uses-long-cache-ttl": ["warn", { "minScore": 0.9 }],
        "link-text": "error",
        "font-display": "error"
      }
    }
  }
}
