# Copy to .env and adjust. .env is gitignored; this file is the
# documented default. Dev-only credentials — never reuse them anywhere.

# --- Postgres (source of truth) ---
POSTGRES_USER=fissionplane
POSTGRES_PASSWORD=fissionplane-dev
POSTGRES_DB=fissionplane
POSTGRES_PORT=5433

# --- Redis (rebuildable cache) ---
REDIS_PORT=6380

# --- ClickHouse (usage metering / analytics) ---
CLICKHOUSE_USER=fissionplane
CLICKHOUSE_PASSWORD=fissionplane-dev
CLICKHOUSE_DB=fissionplane
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002

# --- MinIO (S3-compatible artifact storage) ---
MINIO_ROOT_USER=fissionplane
MINIO_ROOT_PASSWORD=fissionplane-dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Optional tools profile ---
ADMINER_PORT=8080

# --- Connection strings the platform binaries will read ---
# (stubs read PORT only today; these are the names implementation lands on)
DATABASE_URL=postgres://fissionplane:fissionplane-dev@127.0.0.1:5433/fissionplane
REDIS_URL=redis://127.0.0.1:6380/0
CLICKHOUSE_URL=http://fissionplane:fissionplane-dev@127.0.0.1:8123/fissionplane
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=fissionplane-artifacts
S3_ACCESS_KEY=fissionplane
S3_SECRET_KEY=fissionplane-dev

# --- TypeScript web applications ---
# Generate distinct values with `openssl rand -base64 32`. Never share the
# tenant and operator secrets: these are separate authentication domains.
CONSOLE_AUTH_SECRET=replace-with-at-least-32-random-characters
CONSOLE_API_URL=http://localhost:3101
CONSOLE_API_PORT=3101
CONSOLE_WEB_URL=http://localhost:3100

BACKOFFICE_AUTH_SECRET=replace-with-a-different-32-character-secret
BACKOFFICE_API_URL=http://localhost:3201
BACKOFFICE_API_PORT=3201
BACKOFFICE_WEB_URL=http://localhost:3200
