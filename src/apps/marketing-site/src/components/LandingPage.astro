                    <svg data-slot="check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </span>
                </button>
                <pre data-slot="example"><code><span class="t-k">from</span> fissionplane <span class="t-k">import</span> <span class="t-d">FissionPlane</span>

client <span class="t-x">=</span> <span class="t-d">FissionPlane</span><span class="t-x">()</span>
sandbox <span class="t-x">=</span> client<span class="t-x">.</span><span class="t-p">sandboxes</span><span class="t-x">.</span><span class="t-p">create</span><span class="t-x">(</span><span class="t-s">"base"</span><span class="t-x">)</span>

result <span class="t-x">=</span> sandbox<span class="t-x">.</span><span class="t-p">commands</span><span class="t-x">.</span><span class="t-p">run</span><span class="t-x">(</span>
    <span class="t-s">"echo"</span><span class="t-x">,</span>
    args<span class="t-x">=</span><span class="t-x">[</span><span class="t-s">"hello from a microVM"</span><span class="t-x">],</span>
<span class="t-x">)</span>

<span class="t-d">print</span><span class="t-x">(</span>result<span class="t-x">.</span><span class="t-p">stdout</span><span class="t-x">)</span>
sandbox<span class="t-x">.</span><span class="t-p">delete</span><span class="t-x">()</span></code></pre>
                <button type="button" data-slot="copy-code" data-copy={pyExample} data-copy-label={t.install.copyCode} data-copied-label={t.install.copiedLabel} aria-label={t.install.copyCode}>
                  <span data-component="copy-status" aria-hidden="true">
                    <svg data-slot="copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                    <svg data-slot="check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </span>
                </button>
              </div>
              <div data-slot="panel" data-panel="rust">
                <button type="button" data-slot="command" data-copy="cargo add fissionplane" data-copy-label={t.install.copyLabel} data-copied-label={t.install.copiedLabel} aria-label={t.install.copyLabel}>
