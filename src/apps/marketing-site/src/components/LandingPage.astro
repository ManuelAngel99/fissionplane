        <span class="t-p">args</span><span class="t-x">:</span> <span class="t-n">Some</span><span class="t-x">(</span><span class="t-d">vec!</span><span class="t-x">[</span><span class="t-s">"hello from a microVM"</span><span class="t-x">.</span><span class="t-p">to_owned</span><span class="t-x">()]),</span>
        <span class="t-x">..</span><span class="t-d">Default</span><span class="t-x">::</span><span class="t-p">default</span><span class="t-x">()</span>
    <span class="t-x">&#125;;</span>
    <span class="t-k">let</span> result <span class="t-x">=</span> sandbox<span class="t-x">.</span><span class="t-p">commands</span><span class="t-x">()?.</span><span class="t-p">run</span><span class="t-x">(</span>run<span class="t-x">).</span><span class="t-k">await</span><span class="t-x">?;</span>

    <span class="t-d">println!</span><span class="t-x">(</span><span class="t-s">"&#123;&#125;"</span><span class="t-x">,</span> result<span class="t-x">.</span><span class="t-p">stdout</span><span class="t-x">);</span>
    sandbox<span class="t-x">.</span><span class="t-p">delete</span><span class="t-x">().</span><span class="t-k">await</span><span class="t-x">?;</span>
    <span class="t-n">Ok</span><span class="t-x">(())</span>
<span class="t-x">&#125;</span></code></pre>
                <button type="button" data-slot="copy-code" data-copy={rustExample} data-copy-label={t.install.copyCode} data-copied-label={t.install.copiedLabel} aria-label={t.install.copyCode}>
                  <span data-component="copy-status" aria-hidden="true">
                    <svg data-slot="copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                    <svg data-slot="check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </span>
                </button>
              </div>
            </div>
          </div>
              <p data-slot="column-note">
                {t.install.agentPrefix}{" "}
                <button type="button" data-slot="agent-link" data-copy={agentPrompt} data-toast={t.install.copiedToast} data-copy-label={t.install.agentLink} data-copied-label={t.install.copiedToast}>
                  {t.install.agentLink}
                </button>
              </p>
            </div>
          </div>
        </section>

        <section
          data-component="workloads"
          id="workloads"
          aria-labelledby="workloads-heading"
        >
          <div data-slot="section-title">
            <h2 id="workloads-heading">{t.workloads.heading}</h2>
            <p>{t.workloads.intro}</p>
          </div>
          <div data-slot="workload-grid">
            {
              [t.workloads.sandboxes, t.workloads.functions].map((card) => (
                <article data-slot="workload">
                  <h3>{card.title}</h3>
                  <p data-slot="workload-tagline">{card.tagline}</p>
                  <ul>
                    {card.bullets.map((bullet) => (
                      <li>
                        <PixelDot />
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>

        <section
          data-component="architecture"
          id="architecture"
          aria-labelledby="architecture-heading"
        >
          <div data-slot="section-title">
            <h2 id="architecture-heading">{t.architecture.heading}</h2>
            <p>{t.architecture.body}</p>
          </div>
          <pre
            data-slot="diagram"
            role="img"
            aria-label={t.architecture.diagramLabel}>{architectureDiagram}</pre>
        </section>

        <section
          data-component="use-cases"
          id="use-cases"
          aria-labelledby="use-cases-heading"
        >
          <div data-slot="section-title">
            <h2 id="use-cases-heading">{t.useCases.heading}</h2>
          </div>
          <ul>
            {
              t.useCases.items.map((item) => (
                <li>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section
          data-component="what"
          id="what-is-fissionplane"
          aria-labelledby="what-heading"
        >
          <div data-slot="section-title">
            <h2 id="what-heading">{t.what.heading}</h2>
            <p>{t.what.body}</p>
          </div>
          <ul>
            {
              t.what.bullets.map((bullet) => (
                <li>
                  <PixelDot />
                  <span>
                    <strong>{bullet.strong}</strong>{" "}
                    {bullet.text}
                  </span>
                </li>
              ))
            }
          </ul>
          <a href={DOCS_URL}>
            {t.what.link}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.5 12L17 12M13 16.5L17.5 12L13 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" /></svg>
          </a>
        </section>

        <section data-component="faq" id="faq" aria-labelledby="faq-heading">
          <div data-slot="section-title">
            <h2 id="faq-heading">{t.faq.heading}</h2>
          </div>
          <ul>
            {
              t.faq.items.map((faq) => (
                <li>
                  <details>
                    <summary>
                      <span data-slot="faq-icon">
                        <svg data-slot="faq-icon-plus" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M7 5h5v2H7v5H5V7H0V5h5V0h2v5z" fill="currentColor" /></svg>
                        <svg data-slot="faq-icon-minus" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M0 5h12v2H0V5z" fill="currentColor" /></svg>
                      </span>
                      <h3 data-slot="faq-question-text">{faq.question}</h3>
                    </summary>
                    <p data-slot="faq-answer">{faq.answer}</p>
                  </details>
                </li>
              ))
            }
          </ul>
        </section>

        <section data-component="cta" aria-labelledby="cta-heading">
          <div data-slot="cta-copy">
            <strong id="cta-heading">{t.cta.heading}</strong>
            <p>{t.cta.body}</p>
            <a href={DOCS_URL}>
              {t.cta.link}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.5 12L17 12M13 16.5L17.5 12L13 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" /></svg>
            </a>
          </div>
        </section>
      </main>

      <SiteFooter lang={lang} t={t} pagePath="/" />
    </div>

    <div data-component="copy-toast" role="status" aria-live="polite" data-state="hidden">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      <span data-slot="toast-text"></span>
    </div>
  </div>
</Layout>

<script is:inline>
  // Click-to-copy for the install commands, code examples, and the agent
  // prompt. Progressive enhancement: everything stays selectable when the
  // Clipboard API is unavailable.
  const toast = document.querySelector("[data-component='copy-toast']");
  let toastTimer;
  function showToast(message) {
    if (!toast) return;
    toast.querySelector("[data-slot='toast-text']").textContent = message;
    toast.setAttribute("data-state", "visible");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.setAttribute("data-state", "hidden");
    }, 2400);
  }

  for (const button of document.querySelectorAll("[data-copy]")) {
    button.addEventListener("click", async () => {
      const text = button.getAttribute("data-copy") || "";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      const toastMessage = button.getAttribute("data-toast");
      if (toastMessage) showToast(toastMessage);
      button.setAttribute("data-copied", "");
      button.setAttribute(
        "aria-label",
        button.getAttribute("data-copied-label") || "Copied",
      );
      setTimeout(() => {
        button.removeAttribute("data-copied");
        button.setAttribute(
          "aria-label",
          button.getAttribute("data-copy-label") || "Copy install command",
        );
      }, 2000);
    });
  }
</script>
